page 20 (
    name: Manage Tasks
    alias: MANAGE_TASKS
    title: Manage Tasks
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tasks (
        name: Tasks
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       list_id,
                       task_name,
                       display_order,
                       is_complete,
                       completed_on,
                       created_by,
                       created_on,
                       updated_by,
                       updated_on
                  from todo_tasks
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: saveButton
        }
        advanced {
            savedReportMappingIdentifier: 18452185294398039194
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @list_id
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @task_name
                layout {
                    sequence: 20
                }
            )

            displayColumn (
                column: @display_order
                layout {
                    sequence: 30
                }
            )

        )

        column completed_on (
            type: textField
            layout {
                sequence: 61
            }
            source {
                databaseColumn: COMPLETED_ON
                dataType: timestamp
                queryOnly: true
            }
        )

        column created_by (
            type: textField
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
                queryOnly: true
            }
        )

        column created_on (
            type: textField
            layout {
                sequence: 91
            }
            source {
                databaseColumn: CREATED_ON
                dataType: date
                queryOnly: true
            }
        )

        column display_order (
            type: textField
            heading {
                heading: Order
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: DISPLAY_ORDER
                dataType: number
            }
        )

        column is_complete (
            type: textField
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IS_COMPLETE
                dataType: varchar2
                queryOnly: true
            }
        )

        column list_id (
            type: selectList
            heading {
                heading: List
            }
            lov {
                type: sharedComponent
                lov: @todo-lists
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: LIST_ID
                dataType: number
            }
        )

        column task_id (
            type: textField
            layout {
                sequence: 10
            }
            source {
                databaseColumn: TASK_ID
                dataType: number
                primaryKey: true
            }
        )

        column task_name (
            type: textField
            heading {
                heading: Task
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TASK_NAME
                dataType: varchar2
            }
        )

        column updated_by (
            type: textField
            layout {
                sequence: 92
            }
            source {
                databaseColumn: UPDATED_BY
                dataType: varchar2
                queryOnly: true
            }
        )

        column updated_on (
            type: textField
            layout {
                sequence: 93
            }
            source {
                databaseColumn: UPDATED_ON
                dataType: date
                queryOnly: true
            }
        )

    )

    process tasks-save (
        name: Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @tasks
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 18452185540242039194
        }
    )

)

