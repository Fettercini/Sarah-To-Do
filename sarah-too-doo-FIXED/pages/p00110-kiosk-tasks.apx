page 110 (
    name: Kiosk - Complete Tasks
    alias: KIOSK_TASKS
    title: Sarah-Too-Doo
    pageGroup: @kiosk
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            body.t-Body,
            .t-PageBody,
            .t-Body-contentInner {
                background-color: #121212;
                color: #e8e8e8;
            }
            .t-Region,
            .a-Cards {
                background-color: transparent;
            }
            .t-Card,
            .a-Cards-item {
                background-color: #1e1e1e !important;
                border-color: #333333 !important;
                color: #f0f0f0 !important;
            }
            .t-Card:hover,
            .a-Cards-item:hover {
                background-color: #2a2a2a !important;
            }
            .t-Card-title,
            .a-Cards-title,
            .t-Card-body,
            .a-Cards-body {
                color: #f0f0f0 !important;
            }
            .t-Button {
                background-color: #2a2a2a;
                color: #e8e8e8;
                border-color: #444444;
            }
            .t-Button--hot,
            .t-Button.is-active {
                background-color: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
            }
            .fa-check-circle {
                color: #2ecc71 !important;
            }
            ```
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    region back-link (
        name: Back
        type: staticContent
        source {
            htmlCode: <a href="f?p=&APP_ID.:100:&SESSION.">&lt; Back to Lists</a>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region tasks (
        name: Task List
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       task_name,
                       is_complete,
                       case when is_complete = 'Y' then 'fa fa-check-circle' else 'fa fa-circle-thin' end as status_icon
                  from todo_tasks
                 where list_id = :P110_LIST_ID
                 order by is_complete asc, display_order asc, task_id asc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        body {
            column: TASK_NAME
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: STATUS_ICON
        }

        action toggle-complete (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 110
                    items: {
                        P110_TASK_ID: &TASK_ID.
                    }
                    request: TOGGLE
                }
            }
        )

    )

    pageItem P110_LIST_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P110_TASK_ID (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    process toggle-task (
        name: Toggle Task Complete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update todo_tasks
                   set is_complete = case when is_complete = 'Y' then 'N' else 'Y' end,
                       completed_on = case when is_complete = 'N' then systimestamp end,
                       updated_by = :APP_USER,
                       updated_on = sysdate
                 where task_id = :P110_TASK_ID
                   and list_id = :P110_LIST_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 18452186736676039198
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'TOGGLE'
        }
    )

)

