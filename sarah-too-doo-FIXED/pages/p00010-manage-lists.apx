page 10 (
    name: Manage Lists
    alias: MANAGE_LISTS
    title: Manage Lists
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lists (
        name: To-Do Lists
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select list_id,
                       list_name,
                       group_id,
                       display_order,
                       created_by,
                       created_on,
                       updated_by,
                       updated_on
                  from todo_lists
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            addRowIfEmpty: false
        }
        toolbar {
            controls: saveButton
        }
        advanced {
            savedReportMappingIdentifier: 18452184611528039192
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @list_name
                layout {
                    sequence: 10
                }
            )

            displayColumn (
                column: @group_id
                layout {
                    sequence: 20
                }
            )

            displayColumn (
                column: @display_order
                layout {
                    sequence: 30
                }
            )

        )

        column created_by (
            type: textField
            heading {
                heading: created by
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: CREATED_BY
                dataType: varchar2
                queryOnly: true
            }
        )

        column created_on (
            type: textField
            heading {
                heading: created on
            }
            layout {
                sequence: 91
            }
            source {
                databaseColumn: CREATED_ON
                dataType: date
                queryOnly: true
            }
        )

        column display_order (
            type: textField
            heading {
                heading: Order
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DISPLAY_ORDER
                dataType: number
            }
        )

        column group_id (
            type: selectList
            heading {
                heading: Group
            }
            lov {
                type: sharedComponent
                lov: @todo-list-groups
            }
            layout {
                sequence: 25
            }
            source {
                databaseColumn: GROUP_ID
                dataType: number
            }
        )

        column list_id (
            type: textField
            heading {
                heading: list id
            }
            layout {
                sequence: 10
            }
            source {
                databaseColumn: LIST_ID
                dataType: number
                primaryKey: true
            }
        )

        column list_name (
            type: textField
            heading {
                heading: List Name
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: LIST_NAME
                dataType: varchar2
            }
        )

        column updated_by (
            type: textField
            heading {
                heading: updated by
            }
            layout {
                sequence: 92
            }
            source {
                databaseColumn: UPDATED_BY
                dataType: varchar2
                queryOnly: true
            }
        )

        column updated_on (
            type: textField
            heading {
                heading: updated on
            }
            layout {
                sequence: 93
            }
            source {
                databaseColumn: UPDATED_ON
                dataType: date
                queryOnly: true
            }
        )

    )

    process lists-save (
        name: Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @lists
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 18452184964506039193
        }
    )

)

