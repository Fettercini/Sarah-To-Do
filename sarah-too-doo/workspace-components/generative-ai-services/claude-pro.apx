genAIService claude-pro (
    name: Claude-Pro
    provider: CLAUDE
    endpointUrl {
        url: https://api.anthropic.com/v1
    }
    authentication {
        credentials: @credentials-for-claude-pro
    }
    appBuilder {
        usedByAppBuilder: true
        defaultForNewApps: true
    }
    advanced {
        modelName: claude-sonnet-4-5
    }
)

