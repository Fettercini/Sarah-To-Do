app SARAH-TOO-DOO (
    name: Sarah-Too-Doo
    logo {
        type: text
        text: Sarah-Too-Doo
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/top-navigation-tabs
        templateOptions: [
            #DEFAULT#
            t-NavTabs--stacked
            t-NavTabs--displayLabels-sm
        ]
        listPosition: top
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-menu
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
        autoDismissSuccessMessages: true
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    sessionStateProtection {
        checksumSalt: F2A3C88B6DA3A03BBFB8B72387CF4D62E75F8521A58CADCBB000B8E73948EE90
    }
    reportPrinting {
        type: useInstanceSettings
    }
    runtime {
        allowFeedback: true
    }

    substitution APP_NAME (
        value {
            staticValue: Sarah-Too-Doo
        }
    )

)

