list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Lists/Groups/Tasks - Nav

    entry create-group (
        label: Create
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 35
            }
        }
        serverSideCondition {
            type: currentPage=page
            page: 30
        }
    )

    entry create-list (
        label: Create
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 15
                clearCache: 15
            }
        }
        serverSideCondition {
            type: currentPage=page
            page: 10
        }
    )

    entry create-task (
        label: Create
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 25
                clearCache: 25
            }
        }
        serverSideCondition {
            type: currentPage=page
            page: 20
        }
    )

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
                clearCache: 1
            }
        }
    )

    entry lists (
        label: Manage
        icon {
            imageIconCssClasses: fa-list
        }
        layout {
            sequence: 15
        }
        isCurrent {
            type: never
        }
        link {
            target: {
                page: 5
                clearCache: 5
            }
        }
    )

    entry manage-groups (
        label: Manage Groups
        icon {
            imageIconCssClasses: fa-object-group
        }
        layout {
            sequence: 40
            parentEntry: @lists
        }
        link {
            target: {
                page: 30
            }
        }
    )

    entry manage-lists (
        label: Manage Lists
        icon {
            imageIconCssClasses: fa-list
        }
        layout {
            sequence: 20
            parentEntry: @lists
        }
        link {
            target: {
                page: 10
            }
        }
    )

    entry manage-tasks (
        label: Manage Tasks
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 30
            parentEntry: @lists
        }
        link {
            target: {
                page: 20
            }
        }
    )

)

