page 110 (
    name: Kiosk - Complete Tasks
    alias: KIOSK_TASKS
    title: Sarah-Too-Doo
    pageGroup: @kiosk
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            body.t-Body,
            .t-PageBody,
            .t-Body-contentInner {
                background-color: #121212 !important;
                color: #e8e8e8 !important;
            }
            [class*="Region"] {
                background-color: transparent !important;
            }
            [class*="Card"] {
                background-color: #1e1e1e !important;
                border-color: #333333 !important;
                color: #f0f0f0 !important;
            }
            [class*="Card"]:hover {
                background-color: #262626 !important;
            }
            [class*="Card"] * {
                color: #f0f0f0 !important;
            }
            .t-Button {
                background-color: #2a2a2a;
                color: #e8e8e8;
                border-color: #444444;
            }
            .t-Button--hot,
            .t-Button.is-active {
                background-color: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
            }

            .task-row {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 6px 2px;
                animation: taskFadeIn 0.35s ease;
            }
            .task-check {
                flex-shrink: 0;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: 2px solid #777777;
                background-color: transparent;
                position: relative;
                transition: background-color 0.35s ease, border-color 0.35s ease;
            }
            .task-check--done {
                background-color: #2ecc71;
                border-color: #2ecc71;
            }
            .task-check--done::after {
                content: "\2713";
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffffff !important;
                font-size: 16px;
                font-weight: bold;
            }
            .task-text {
                font-size: 1.15rem;
                transition: opacity 0.35s ease;
            }
            .task-text--done {
                opacity: 0.5;
                text-decoration: line-through;
            }
            @keyframes taskFadeIn {
                from {
                    opacity: 0;
                    transform: translateY(4px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            ```
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    pageItem P110_LIST_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P110_TASK_ID (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    region back-link (
        name: Back
        type: staticContent
        source {
            htmlCode: <a href="f?p=&APP_ID.:100:&SESSION.">&lt; Back to Lists</a>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region tasks (
        name: Task List
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       task_name,
                       is_complete
                  from todo_tasks
                 where list_id = :P110_LIST_ID
                 order by is_complete asc, display_order asc, task_id asc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="task-row">
                    <span class="task-check{if IS_COMPLETE} task-check--done{if/}"></span>
                    <span class="task-text{if IS_COMPLETE} task-text--done{if/}">#TASK_NAME#</span>
                </div>
                ```
        }

        action toggle-complete (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 110
                    request: TOGGLE
                    items: {
                        P110_TASK_ID: &TASK_ID.
                    }
                }
            }
        )

    )

    process toggle-task (
        name: Toggle Task Complete
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                update todo_tasks
                   set is_complete = case when is_complete = 'Y' then 'N' else 'Y' end,
                       completed_on = case when is_complete = 'N' then systimestamp end,
                       updated_by = :APP_USER,
                       updated_on = sysdate
                 where task_id = :P110_TASK_ID
                   and list_id = :P110_LIST_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'TOGGLE'
        }
    )

)
