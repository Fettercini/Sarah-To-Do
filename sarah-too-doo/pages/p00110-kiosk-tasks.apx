page 110 (
    name: Kiosk - Complete Tasks
    alias: KIOSK_TASKS
    title: Sarah-Too-Doo
    pageGroup: @kiosk
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        inline:
            ```css
            body.t-Body,
            .t-PageBody,
            .t-Body-contentInner,
            .t-Region {
                background-color: #121212 !important;
                color: #e8e8e8 !important;
            }
            .kiosk-card,
            .kiosk-card * {
                background-color: #1e1e1e !important;
                color: #f0f0f0 !important;
            }
            .kiosk-card {
                border-color: #333333 !important;
            }
            .kiosk-card:hover {
                background-color: #262626 !important;
            }
            .t-Button {
                background-color: #2a2a2a;
                color: #e8e8e8;
                border-color: #444444;
            }
            .t-Button--hot,
            .t-Button.is-active {
                background-color: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
            }

            .task-row {
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 6px 2px;
                animation: taskFadeIn 0.35s ease;
            }
            .task-check {
                flex-shrink: 0;
                width: 28px;
                height: 28px;
                border-radius: 6px;
                border: 2px solid #777777;
                background-color: transparent;
                position: relative;
                transition: background-color 0.35s ease, border-color 0.35s ease;
            }
            .task-check--done {
                background-color: #2ecc71;
                border-color: #2ecc71;
            }
            .task-check--done::after {
                content: "\2713";
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffffff !important;
                font-size: 16px;
                font-weight: bold;
            }
            .task-text {
                font-size: 1.15rem;
                transition: opacity 0.35s ease;
            }
            .task-text--done {
                opacity: 0.5;
                text-decoration: line-through;
            }
            @keyframes taskFadeIn {
                from {
                    opacity: 0;
                    transform: translateY(4px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
            ```
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    pageItem P110_LIST_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

    pageItem P110_TASK_ID (
        type: hidden
        layout {
            sequence: 20
            slot: body
        }
    )

    region back-link (
        name: Back
        type: staticContent
        source {
            htmlCode: <a href="f?p=&APP_ID.:100:&SESSION.">&lt; Back to Lists</a>
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--scrollBody
            ]
        }
    )

    region tasks (
        name: Task List
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       task_name,
                       is_complete
                  from todo_tasks
                 where list_id = :P110_LIST_ID
                 order by is_complete asc, display_order asc, task_id asc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        card {
            cssClasses: [
                kiosk-card
            ]
        }
        title {
            advancedFormatting: true
            htmlExpression:
                ```html
                <div class="task-row" data-task-id="&TASK_ID.">
                    <span class="task-check{if IS_COMPLETE/} task-check--done{endif/}"></span>
                    <span class="task-text{if IS_COMPLETE/} task-text--done{endif/}">&TASK_NAME!HTML.</span>
                </div>
                ```
        }

    )

    dynamicAction toggle-task-ajax (
        name: Toggle Task Complete
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .task-row
        }

        action optimistic-toggle (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var $row = $( this.triggeringElement );
                    var $check = $row.find( ".task-check" );
                    var $text = $row.find( ".task-text" );
                    var nowComplete = !$check.hasClass( "task-check--done" );
                    $check.toggleClass( "task-check--done", nowComplete );
                    $text.toggleClass( "task-text--done", nowComplete );
                    apex.item( "P110_TASK_ID" ).setValue( $row.data( "taskId" ) );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action persist-toggle (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    update todo_tasks
                       set is_complete = case when is_complete = 'Y' then 'N' else 'Y' end,
                           completed_on = case when is_complete = 'N' then systimestamp end,
                           updated_by = :APP_USER,
                           updated_on = sysdate
                     where task_id = :P110_TASK_ID
                       and list_id = :P110_LIST_ID;
                    ```
                itemsToSubmit: [
                    P110_TASK_ID
                    P110_LIST_ID
                ]
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)
