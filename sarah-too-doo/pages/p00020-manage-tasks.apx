page 20 (
    name: Manage Tasks
    alias: MANAGE_TASKS
    title: Manage Tasks
    pageGroup: @administration
    appearance {
        pageTemplate: @standard-no-header
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tasks (
        name: Tasks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.task_id,
                       t.task_name,
                       l.list_name,
                       t.is_complete,
                       t.display_order
                  from todo_tasks t
                  join todo_lists l
                    on l.list_id = t.list_id
                 order by l.list_name, t.display_order, t.task_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column DISPLAY_ORDER (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Display Order
                alignment: center
            }
            layout {
                sequence: 50
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column IS_COMPLETE (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Is Complete
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column LIST_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List Name
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column TASK_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column TASK_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Task Name
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    button create-task (
        buttonName: CREATE
        label: Add Task
        layout {
            sequence: 10
            region: @tasks
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                clearCache: 25
            }
        }
        config {
            buildOption: @commented-out
        }
    )

    dynamicAction refresh-tasks-after-dialog (
        name: Refresh Tasks After Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tasks
        }

        action refresh-tasks (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tasks
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

