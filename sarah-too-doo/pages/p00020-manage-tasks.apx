page 20 (
    name: Manage Tasks
    alias: MANAGE_TASKS
    title: Manage Tasks
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region tasks (
        name: Tasks
        type: interactiveGrid
        layout {
            sequence: 10
            slot: contentBody
        }
        source {
            location: localDatabase
            type: tableView
            tableName: TODO_TASKS
        }

        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
            addRowIfEmpty: false
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
        )

    )

    process tasks-save (
        name: Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        identification {
            editableRegion: @tasks
        }
        execution {
            sequence: 10
            point: processing
        }
    )

)
