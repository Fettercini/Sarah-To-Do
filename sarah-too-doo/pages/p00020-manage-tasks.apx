page 20 (
    name: Manage Tasks
    alias: MANAGE_TASKS
    title: Manage Tasks
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region toolbar (
        name: Toolbar
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region tasks (
        name: Tasks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.task_id,
                       t.task_name,
                       l.list_name,
                       t.is_complete,
                       t.display_order
                  from todo_tasks t
                  join todo_lists l
                    on l.list_id = t.list_id
                 order by l.list_name, t.display_order, t.task_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column task_id (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column task_name (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Task
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
            link {
                target: {
                    page: 25
                    items: {
                        P25_TASK_ID: #TASK_ID#
                    }
                    clearCache: 25
                }
                linkText: #TASK_NAME#
            }
        )

        column list_name (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: List
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )

        column is_complete (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Complete
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
        )

        column display_order (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Order
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
        )

    )

    button create-task (
        buttonName: CREATE
        label: Add Task
        layout {
            sequence: 10
            region: @toolbar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 25
                clearCache: 25
            }
        }
    )

    dynamicAction refresh-tasks-after-dialog (
        name: Refresh Tasks After Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tasks
        }

        action refresh-tasks (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tasks
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
