page 30 (
    name: Manage Groups
    alias: MANAGE_GROUPS
    title: Manage Groups
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region toolbar (
        name: Toolbar
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region groups (
        name: List Groups
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select group_id,
                       group_name,
                       display_order
                  from todo_list_groups
                 order by display_order, group_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column group_id (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column group_name (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: Group Name
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
            link {
                target: {
                    page: 35
                    items: {
                        P35_GROUP_ID: #GROUP_ID#
                    }
                    clearCache: 35
                }
                linkText: #GROUP_NAME#
            }
        )

        column display_order (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Order
                alignment: end
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
        )

    )

    button create-group (
        buttonName: CREATE
        label: Add Group
        layout {
            sequence: 10
            region: @toolbar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 35
                clearCache: 35
            }
        }
    )

    dynamicAction refresh-groups-after-dialog (
        name: Refresh Groups After Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @groups
        }

        action refresh-groups (
            action: refresh
            affectedElements {
                selectionType: region
                region: @groups
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
