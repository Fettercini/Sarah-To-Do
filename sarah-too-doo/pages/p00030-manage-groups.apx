page 30 (
    name: Manage Groups
    alias: MANAGE_GROUPS
    title: Manage Groups
    pageGroup: @administration
    appearance {
        pageTemplate: @standard-no-header
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region groups (
        name: List Groups
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select group_id,
                       group_name,
                       display_order
                  from todo_list_groups
                 order by display_order, group_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column DISPLAY_ORDER (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Display Order
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column GROUP_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column GROUP_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Group Name
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    button create-group (
        buttonName: CREATE
        label: Add Group
        layout {
            sequence: 10
            region: @groups
            slot: rightOfTitle
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 35
                clearCache: 35
            }
        }
        config {
            buildOption: @commented-out
        }
    )

    dynamicAction refresh-groups-after-dialog (
        name: Refresh Groups After Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: domObject
            domObject: body
        }

        action refresh-groups (
            action: refresh
            affectedElements {
                selectionType: region
                region: @groups
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

