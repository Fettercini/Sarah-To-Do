page 10 (
    name: Manage Lists
    alias: MANAGE_LISTS
    title: Manage Lists
    pageGroup: @administration
    appearance {
        pageTemplate: @standard-no-header
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lists (
        name: To-Do Lists
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.list_id,
                       l.list_name,
                       g.group_name,
                       l.display_order
                  from todo_lists l
                  left join todo_list_groups g
                    on g.group_id = l.group_id
                order by l.display_order, l.list_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column DISPLAY_ORDER (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Display Order
                alignment: center
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column GROUP_NAME (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Group Name
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

        column LIST_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column LIST_NAME (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: List Name
                alignment: center
            }
            layout {
                sequence: 20
                columnAlignment: center
            }
            sorting {
                sortable: false
            }
        )

    )

    button create-list (
        buttonName: CREATE
        label: Add List
        layout {
            sequence: 10
            region: @lists
            slot: copy
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
                clearCache: 15
            }
        }
        config {
            buildOption: @commented-out
        }
    )

    dynamicAction refresh-lists-after-dialog (
        name: Refresh Lists After Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lists
        }

        action refresh-lists (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lists
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

