page 10 (
    name: Manage Lists
    alias: MANAGE_LISTS
    title: Manage Lists
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lists (
        name: To-Do Lists
        type: interactiveGrid
        layout {
            sequence: 10
            slot: contentBody
        }
        source {
            location: localDatabase
            type: tableView
            tableName: TODO_LISTS
        }

        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
            addRowIfEmpty: false
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
        )

    )

    process lists-save (
        name: Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        identification {
            editableRegion: @lists
        }
        execution {
            sequence: 10
            point: processing
        }
    )

)
