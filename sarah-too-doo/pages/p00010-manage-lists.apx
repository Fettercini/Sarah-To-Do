page 10 (
    name: Manage Lists
    alias: MANAGE_LISTS
    title: Manage Lists
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region lists (
        name: To-Do Lists
        type: interactiveGrid
        layout {
            sequence: 10
            slot: body
        }
        source {
            location: localDatabase
            type: tableView
            tableName: TODO_LISTS
        }

        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
            lostUpdateType: rowValues
            addRowIfEmpty: false
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
        )

        column list_id (
            type: textField
            layout {
                sequence: 10
            }
            enableUsersTo {
                sort: false
                hide: true
            }
            source {
                type: databaseColumn
                databaseColumn: LIST_ID
                dataType: number
                queryOnly: false
                primaryKey: true
            }
        )

        column list_name (
            type: textField
            heading {
                heading: List Name
            }
            layout {
                sequence: 20
            }
            enableUsersTo {
                sort: true
                hide: false
            }
            source {
                type: databaseColumn
                databaseColumn: LIST_NAME
                dataType: varchar2
                queryOnly: false
                primaryKey: false
            }
        )

        column display_order (
            type: textField
            heading {
                heading: Order
            }
            layout {
                sequence: 30
            }
            enableUsersTo {
                sort: true
                hide: false
            }
            source {
                type: databaseColumn
                databaseColumn: DISPLAY_ORDER
                dataType: number
                queryOnly: false
                primaryKey: false
            }
        )

        column created_by (
            type: textField
            layout {
                sequence: 90
            }
            enableUsersTo {
                sort: false
                hide: true
            }
            source {
                type: databaseColumn
                databaseColumn: CREATED_BY
                dataType: varchar2
                queryOnly: true
                primaryKey: false
            }
        )

        column created_on (
            type: textField
            layout {
                sequence: 91
            }
            enableUsersTo {
                sort: false
                hide: true
            }
            source {
                type: databaseColumn
                databaseColumn: CREATED_ON
                dataType: date
                queryOnly: true
                primaryKey: false
            }
        )

        column updated_by (
            type: textField
            layout {
                sequence: 92
            }
            enableUsersTo {
                sort: false
                hide: true
            }
            source {
                type: databaseColumn
                databaseColumn: UPDATED_BY
                dataType: varchar2
                queryOnly: true
                primaryKey: false
            }
        )

        column updated_on (
            type: textField
            layout {
                sequence: 93
            }
            enableUsersTo {
                sort: false
                hide: true
            }
            source {
                type: databaseColumn
                databaseColumn: UPDATED_ON
                dataType: date
                queryOnly: true
                primaryKey: false
            }
        )

    )

    process lists-save (
        name: Save Interactive Grid Data
        type: interactiveGridAutoRowProcessing
        identification {
            editableRegion: @lists
        }
        execution {
            sequence: 10
            point: processing
        }
    )

)
