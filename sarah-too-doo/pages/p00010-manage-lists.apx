page 10 (
    name: Manage Lists
    alias: MANAGE_LISTS
    title: Manage Lists
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region toolbar (
        name: Toolbar
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region lists (
        name: To-Do Lists
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.list_id,
                       l.list_name,
                       g.group_name,
                       l.display_order
                  from todo_lists l
                  left join todo_list_groups g
                    on g.group_id = l.group_id
                 order by l.display_order, l.list_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column list_id (
            reportColumnQueryId: 1
            derivedColumn: N
            type: hidden
            layout {
                sequence: 10
            }
        )

        column list_name (
            reportColumnQueryId: 2
            derivedColumn: N
            type: link
            heading {
                heading: List Name
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
            link {
                target: {
                    page: 15
                    items: {
                        P15_LIST_ID: #LIST_ID#
                    }
                    clearCache: 15
                }
                linkText: #LIST_NAME#
            }
        )

        column group_name (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Group
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )

        column display_order (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Order
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
        )

    )

    button create-list (
        buttonName: CREATE
        label: Add List
        layout {
            sequence: 10
            region: @toolbar
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 15
                clearCache: 15
            }
        }
    )

    dynamicAction refresh-lists-after-dialog (
        name: Refresh Lists After Dialog
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @lists
        }

        action refresh-lists (
            action: refresh
            affectedElements {
                selectionType: region
                region: @lists
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
