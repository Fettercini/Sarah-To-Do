page 100 (
    name: Kiosk - Select List
    alias: KIOSK_SELECT_LIST
    title: Sarah-Too-Doo
    pageGroup: @kiosk
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authentication: public
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }

    region select-list (
        name: Select a To-Do List
        type: cards
        layout {
            sequence: 10
            slot: body
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select list_id,
                       list_name
                  from todo_lists
                 order by display_order, list_name
                ```
        }

        action open-list (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: f?p=&APP_ID.:110:&SESSION.::NO::P110_LIST_ID:#LIST_ID#
            }
        )

    )

)
