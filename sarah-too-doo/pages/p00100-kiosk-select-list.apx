page 100 (
    name: Kiosk - Select List
    alias: KIOSK_SELECT_LIST
    title: Sarah-Too-Doo
    pageGroup: @kiosk
    appearance {
        pageTemplate: @standard-no-header
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            html {
                font-size: clamp(14px, 1.1vw + 0.6vh, 22px);
            }
            #t_Header {
                display: none;
            }
            body.t-Body,
            .t-PageBody,
            .t-Body-contentInner,
            .t-Region {
                background-color: #121212 !important;
                color: #e8e8e8 !important;
            }
            .kiosk-card {
                background-color: #1e1e1e !important;
                border-color: #333333 !important;
                min-height: clamp(64px, 10vh, 140px);
                display: flex !important;
                align-items: center;
                justify-content: center;
            }
            .kiosk-card:hover {
                background-color: #2a2a2a !important;
            }
            .kiosk-title {
                font-size: clamp(1.1rem, 1.2vw + 0.9rem, 2rem);
                font-weight: 600;
                color: #f5f5f5 !important;
                text-align: center;
                padding: clamp(8px, 1.5vw, 20px) clamp(6px, 2vw, 16px);
                line-height: 1.3;
                width: 100%;
            }
            .t-Button {
                background-color: #2a2a2a;
                color: #e8e8e8;
                border-color: #444444;
            }
            .t-Button--hot,
            .t-Button.is-active {
                background-color: #0d6efd;
                border-color: #0d6efd;
                color: #ffffff;
            }
            ```
    }
    security {
        authentication: public
        formAutoComplete: false
    }

    region group-filter (
        name: Filter by Group
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select cast(null as number) as group_id,
                       'All Lists' as group_name,
                       0 as display_order
                  from dual
                 union all
                select group_id,
                       group_name,
                       display_order
                  from todo_list_groups
                 order by display_order, group_name
                ```
        }
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        card {
            cssClasses: kiosk-card
        }
        title {
            advancedFormatting: true
            htmlExpression: <div class="kiosk-title">&GROUP_NAME!HTML.</div>
        }

        action select-group (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 100
                    items: {
                        P100_GROUP_ID: &GROUP_ID.
                    }
                    clearCache: 100
                }
            }
        )

    )

    region select-list (
        name: Select a To-Do List
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select list_id,
                       list_name
                  from todo_lists
                 where ( :P100_GROUP_ID is null or group_id = :P100_GROUP_ID )
                 order by display_order, list_name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
        card {
            cssClasses: kiosk-card
        }
        title {
            advancedFormatting: true
            htmlExpression: <div class="kiosk-title">&LIST_NAME!HTML.</div>
        }

        action open-list (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                target: {
                    page: 110
                    items: {
                        P110_LIST_ID: &LIST_ID.
                    }
                    clearCache: 110
                }
            }
        )

    )

    pageItem P100_GROUP_ID (
        type: hidden
        layout {
            sequence: 10
            slot: body
        }
    )

)

